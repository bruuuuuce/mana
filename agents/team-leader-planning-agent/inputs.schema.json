{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "team-leader-planning-agent inputs",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "epic": { "type": "string" },
    "stories": { "type": "string" },
    "planning_artifacts": { "type": "string" },
    "team_constraints": { "type": "string" },
    "repository_snapshot": { "type": "string" },
    "historical_calibration_approved": {
      "type": "boolean",
      "default": false,
      "description": "Allows read-only, team-level historical calibration of story estimates after explicit user approval."
    }
  }
}
