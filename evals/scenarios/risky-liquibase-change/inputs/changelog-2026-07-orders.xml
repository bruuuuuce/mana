<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2026-07-orders-status-backfill" author="dev.example">
        <addColumn tableName="orders">
            <column name="fulfillment_status" type="varchar(32)"/>
        </addColumn>
        <update tableName="orders">
            <column name="fulfillment_status" value="LEGACY"/>
        </update>
        <createIndex tableName="orders" indexName="idx_orders_fulfillment_status">
            <column name="fulfillment_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
