{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mana UserContextCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidateId", "synthesisVersion", "lifecycleState", "guidance", "scope", "sourceClusterIds", "supportingSignalIds", "supportingProjectIds", "counterEvidence", "synthesis", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "kind": {"const": "user-context-candidate"},
    "candidateId": {"type": "string", "pattern": "^user-context-candidate-[0-9a-f]{64}$"},
    "synthesisVersion": {"const": "m3-bounded-semantic-synthesis-v1"},
    "lifecycleState": {"enum": ["proposed", "deferred-for-review"]},
    "guidance": {"type": "string", "minLength": 1, "maxLength": 600},
    "scope": {"type": "string", "minLength": 1, "maxLength": 120},
    "sourceClusterIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^cluster-[0-9a-f]{64}$"}},
    "supportingSignalIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^user-choice-[0-9a-f]{64}$"}},
    "supportingProjectIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^project-[0-9a-f]{64}$"}},
    "counterEvidence": {"type": "array"},
    "synthesis": {"type": "object", "additionalProperties": false, "required": ["modelTier", "provider", "model", "inputFingerprint", "invocation", "rationale", "limitations"], "properties": {"modelTier": {"const": "T1"}, "provider": {"type": "string"}, "model": {"type": "string"}, "inputFingerprint": {"type": "string", "pattern": "^m3-input-[0-9a-f]{64}$"}, "invocation": {"type": "object"}, "rationale": {"type": "string"}, "limitations": {"type": "array"}}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
