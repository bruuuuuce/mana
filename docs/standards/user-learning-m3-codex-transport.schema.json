{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mana M3 Codex transport result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "result": { "type": "string", "enum": ["CANDIDATE", "NO_CANDIDATE"] },
    "guidance": { "type": "string" },
    "scope": { "type": "string" },
    "rationale": { "type": "string" },
    "reason": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
    "relatedClusterIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 8 },
    "supportingSignalIds": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 32 }
  },
  "required": ["result", "guidance", "scope", "rationale", "reason", "limitations", "relatedClusterIds", "supportingSignalIds"]
}
