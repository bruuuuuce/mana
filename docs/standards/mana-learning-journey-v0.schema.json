{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/schemas/mana-learning-journey-v0.schema.json",
  "title": "Mana Learning Journey v0",
  "$defs": {
    "id": { "type": "string", "pattern": "^(jrn|jn|je|anc|ev|exp|hyp|occ|trv|cyc|enr|git|tle|hya|dia)_[a-f0-9]{24}$" },
    "nodeId": { "type": "string", "pattern": "^jn_[a-f0-9]{24}$" },
    "record": {
      "type": "object",
      "required": ["schema", "record_type", "id"],
      "properties": { "schema": {"const":"mana.learning.record/v1"}, "id":{"$ref":"#/$defs/id"} }
    },
    "journey": {
      "type": "object", "required": ["schema","id","title","repository_revision","scope"],
      "properties": {
        "schema":{"const":"mana.learning.journey/v1"}, "id":{"type":"string","pattern":"^jrn_[a-f0-9]{24}$"}, "title":{"type":"string","minLength":1}, "repository_revision":{"type":"string"},
        "scope":{"type":"object","required":["start","termination","boundaries"],"properties":{"start":{"type":"object","required":["kind","value"]},"termination":{"type":"object","required":["kind","condition"]},"boundaries":{"type":"object"}}}
      }
    },
    "node": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"node"},"kind":{"enum":["code","runtime_effect","boundary","external_system","concept_occurrence","explanation","hypothesis","timeline_event"]},"state":{"enum":["discovered","expanded"]},"label":{"type":"string"},"disposition":{"enum":["primary","deferred"]}},"required":["kind","state"]}]},
    "edge": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"edge"},"from":{"$ref":"#/$defs/nodeId"},"to":{"$ref":"#/$defs/nodeId"},"kind":{"enum":["CALLS","EXECUTES","DEPENDS_ON","RETURNS_TO","LOOP_BACK","EXPLAINS","EXEMPLIFIES","INTRODUCES_CONCEPT","DEEP_DIVE","MAY_EXIST_BECAUSE","SUPPORTED_BY","CONTRADICTED_BY","RELATED_TO"]},"disposition":{"enum":["primary","deferred"]}},"required":["from","to","kind"]}]},
    "anchor": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"anchor"},"node_id":{"$ref":"#/$defs/nodeId"},"revision":{"type":"string"},"path":{"type":"string"},"range":{"type":"object","required":["start_line","end_line"]}},"required":["node_id","revision","path","range"]}]},
    "evidence": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"evidence"},"kind":{"enum":["source_range","symbol","configuration","test","git_commit","git_diff","documentation","adr","runtime_semantic"]},"anchor_id":{"type":"string","pattern":"^anc_[a-f0-9]{24}$"}},"required":["kind"]}]},
    "explanation": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"explanation"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"status":{"enum":["available","completed","failed"]},"body":{"type":"string"},"epistemic_status":{"enum":["documented","strongly_supported","plausible","speculative","unknown"]},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^ev_[a-f0-9]{24}$"}}},"required":["subject_node_id"]}]},
    "enrichment": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"enrichment"},"request_id":{"type":"string","pattern":"^exr_[a-f0-9]{24}$"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"kind":{"const":"explanation"},"status":{"enum":["requested","completed","failed"]},"reason":{"type":"string"}},"required":["request_id","subject_node_id","kind","status"]}]},
    "hypothesis": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"hypothesis"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"claim":{"type":"string"},"confidence":{"enum":["documented","strongly_supported","plausible","speculative","unknown"]},"category":{"enum":["legacy_residue","incomplete_migration","planned_extensibility","removed_feature","compatibility_boundary","external_constraint","compliance_security","organizational_boundary","premature_generalization","performance_optimization","vendor_api_limitation","unknown"]},"verification_suggestions":{"type":"array","items":{"type":"string"}}},"required":["subject_node_id","claim","confidence"]}]},
    "gitEnrichment": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"git_enrichment"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"anchor_id":{"type":"string","pattern":"^anc_[a-f0-9]{24}$"},"status":{"enum":["completed","failed"]},"scope_path":{"type":"string"},"reason":{"type":"string"}},"required":["subject_node_id","anchor_id","status"]}]},
    "timelineEvent": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"timeline_event"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"anchor_id":{"type":"string","pattern":"^anc_[a-f0-9]{24}$"},"evidence_id":{"type":"string","pattern":"^ev_[a-f0-9]{24}$"},"revision":{"type":"string","pattern":"^[a-f0-9]{7,64}$"},"occurred_at":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1}},"required":["subject_node_id","anchor_id","evidence_id","revision","occurred_at","summary"]}]},
    "hypothesisAssessment": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"hypothesis_assessment"},"hypothesis_id":{"type":"string","pattern":"^hyp_[a-f0-9]{24}$"},"evidence_id":{"type":"string","pattern":"^ev_[a-f0-9]{24}$"},"effect":{"enum":["strengthens","weakens","inconclusive"]},"reason":{"type":"string","minLength":1}},"required":["hypothesis_id","evidence_id","effect","reason"]}]},
    "diagram": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"diagram"},"kind":{"enum":["sequence","component"]},"asset_path":{"type":"string","pattern":"^assets/[A-Za-z0-9._/-]+\\.puml$"},"node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/nodeId"}},"title":{"type":"string"}},"required":["kind","asset_path","node_ids"]}]},
    "conceptOccurrence": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"concept_occurrence"},"concept_id":{"type":"string","pattern":"^cpt_[0-9]{3}$"},"subject_node_id":{"$ref":"#/$defs/nodeId"},"relevance":{"enum":["primary","supporting","incidental"]},"classifier_request_id":{"type":"string","pattern":"^ccr_[a-f0-9]{24}$"}},"required":["concept_id","subject_node_id","relevance"]}]},
    "traversal": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"traversal"},"entry_node_id":{"$ref":"#/$defs/nodeId"},"node_ids":{"type":"array","items":{"$ref":"#/$defs/nodeId"}}},"required":["entry_node_id"]}]},
    "cycleRegion": {"allOf":[{"$ref":"#/$defs/record"},{"properties":{"record_type":{"const":"cycle_region"},"entry_node_id":{"$ref":"#/$defs/nodeId"},"node_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nodeId"}},"back_edge_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^je_[a-f0-9]{24}$"}},"kind":{"enum":["retry","polling","event_loop","state_cycle","recursive","unknown"]}},"required":["entry_node_id","node_ids","back_edge_ids","kind"]}]}
  }
}
