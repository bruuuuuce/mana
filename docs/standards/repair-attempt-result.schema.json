{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mana Repair Attempt Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "attemptId", "runtimeExecutionId", "target", "provider", "runner", "executionPlanIdentity", "isolation", "candidate", "import", "allowedPaths", "protectedSurfaceDigest", "actualMutatedPaths", "patchDigest", "scopeViolations", "evaluationSurfaceChanges", "beforeVerification", "afterVerification", "comparison", "comparabilityReasons", "resolvedFailures", "persistentFailures", "newRequiredFailures", "newOptionalFailures", "progress", "attemptStatus", "stopReason", "limitations", "wallTimeMs", "verificationRerunCount", "judgment"],
  "properties": {
    "schemaVersion": {"const": "1"}, "kind": {"const": "repair-attempt-result"}, "attemptId": {"type": "string", "pattern": "^repair-attempt-"}, "runtimeExecutionId": {"type": "string"},
    "target": {"type": "object"}, "provider": {"enum": ["codex", "claude", "opencode", "stub"]}, "runner": {"type": "object"}, "executionPlanIdentity": {"type": "string"},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["capability", "backend", "adversarialBoundary", "liveRepositoryProviderAccess", "hostPatchImport", "processIsolation", "hostFilesystemIsolation", "networkIsolation"], "properties": {"capability": {"const": "faulty-contained"}, "backend": {"const": "disposable-workspace"}, "adversarialBoundary": {"const": false}, "liveRepositoryProviderAccess": {"const": false}, "hostPatchImport": {"const": true}, "processIsolation": {"const": false}, "hostFilesystemIsolation": {"const": false}, "networkIsolation": {"const": false}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["workspaceIdentity", "workspaceIntegrity", "changedPaths", "candidateDigest", "changedLineCount", "policyViolations"], "properties": {"workspaceIdentity": {"type": "string"}, "workspaceIntegrity": {"type": "boolean"}, "changedPaths": {"type": "array", "items": {"type": "string"}}, "candidateDigest": {"type": "string"}, "changedLineCount": {"type": "integer", "minimum": 0}, "policyViolations": {"type": "array", "items": {"type": "string"}}}},
    "import": {"type": "object", "additionalProperties": false, "required": ["baselineDigest", "baselineContentDigest", "baselineType", "baselineMode", "workingTreeState", "repairTargetId", "evaluationSurfaceDigest", "liveBaselineMatched", "applied", "importedDigest"], "properties": {"baselineDigest": {"type": "string"}, "baselineContentDigest": {"type": "string"}, "baselineType": {"const": "regular"}, "baselineMode": {"type": "string"}, "workingTreeState": {"enum": ["clean", "modified", "untracked"]}, "repairTargetId": {"type": "string"}, "evaluationSurfaceDigest": {"type": "string"}, "liveBaselineMatched": {"type": ["boolean", "null"]}, "applied": {"type": "boolean"}, "importedDigest": {"type": ["string", "null"]}}},
    "allowedPaths": {"type": "array", "maxItems": 1, "items": {"type": "string"}}, "protectedSurfaceDigest": {"type": "string"}, "actualMutatedPaths": {"type": "array", "items": {"type": "string"}}, "patchDigest": {"type": "string"}, "scopeViolations": {"type": "array"}, "evaluationSurfaceChanges": {"type": "array"},
    "beforeVerification": {"type": "object"}, "afterVerification": {"type": ["object", "null"]}, "comparison": {"enum": ["RESOLVED", "UNCHANGED", "REGRESSED", "UNKNOWN"]}, "comparabilityReasons": {"type": "array"}, "resolvedFailures": {"type": "array"}, "persistentFailures": {"type": "array"}, "newRequiredFailures": {"type": "array"}, "newOptionalFailures": {"type": "array"}, "progress": {"enum": ["partial", null]},
    "attemptStatus": {"enum": ["completed", "policy_violation", "integrity_violation", "runner_failed", "runner_timed_out", "verification_failed", "interrupted"]}, "stopReason": {"type": "string"}, "limitations": {"type": "array"}, "wallTimeMs": {"type": "integer", "minimum": 0}, "verificationRerunCount": {"enum": [0, 1]}, "judgment": {"type": "null"}
  }
}
