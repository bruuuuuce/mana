{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mana Verification Result v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "runId", "runtimeExecutionId", "generatedAt", "startedAt", "projectRevision", "workingTreeDirtyBefore", "scope", "overallResult", "selections", "checks", "observedEffects", "cost", "judgment"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|unavailable)$"},
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["source_tree", "mana_workspace", "build_outputs", "external_state", "network"],
      "properties": {
        "source_tree": {"enum": ["none", "declared_paths"]},
        "mana_workspace": {"enum": ["none", "write"]},
        "build_outputs": {"enum": ["none", "write"]},
        "external_state": {"enum": ["none", "isolated_test_read", "isolated_test_write"]},
        "network": {"enum": ["none", "declared"]}
      }
    }
  },
  "properties": {
    "schemaVersion": {"enum": ["1", "2"]}, "kind": {"const": "verification-result"},
    "frameworkIdentity": {"type": "object", "additionalProperties": false, "required": ["verificationImplementationDigest"], "properties": {"verificationImplementationDigest": {"$ref": "#/$defs/digest"}}},
    "rerunOf": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["resultReference", "resultDigest", "runId", "checkId"], "properties": {"resultReference": {"type": "string"}, "resultDigest": {"$ref": "#/$defs/digest"}, "runId": {"type": "string"}, "checkId": {"type": "string"}}}]},
    "runId": {"type": "string", "minLength": 1}, "runtimeExecutionId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string"}, "startedAt": {"type": "string"}, "projectRevision": {"type": "string"},
    "workingTreeDirtyBefore": {"type": "boolean"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "head", "mode", "changedPathsDigest", "changedPaths", "inputDigest"],
      "properties": {
        "base": {"type": "string"}, "head": {"type": "string"}, "mode": {"enum": ["repository", "working-tree-only"]},
        "changedPathsDigest": {"$ref": "#/$defs/digest"}, "inputDigest": {"$ref": "#/$defs/digest"},
        "changedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "overallResult": {"enum": ["passed", "failed", "blocked", "partial", "inconclusive"]},
    "selections": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skillId", "mode", "applicability", "selected", "reasons"],
        "properties": {
          "skillId": {"type": "string"}, "mode": {"enum": ["automatic", "explicit"]},
          "applicability": {"enum": ["applicable", "not_applicable", "blocked"]}, "selected": {"type": "boolean"},
          "reasons": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group", "predicate", "pass", "detail"], "properties": {"group": {"type": "string"}, "predicate": {"type": "string"}, "pass": {"type": "boolean"}, "detail": {"type": "string"}}}}
        }
      }
    },
    "checks": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skillId", "skillVersion", "specDigest", "checkId", "baseCheckId", "required", "targetFingerprint", "actionFingerprint", "executionFingerprint", "failureFingerprint", "deduplicated", "adapter", "trustOrigin", "commandOrigin", "effectiveArgv", "executable", "workingDirectory", "environmentClassification", "environmentDigest", "inputDigest", "scope", "costClass", "result", "exitCode", "signal", "timedOut", "descendantsTerminated", "durationMs", "timeoutSeconds", "outputLimitBytes", "relevantFiles", "observations", "nativeArtifacts", "output", "declaredEffects", "observedEffects", "limitations"],
        "properties": {
          "skillId": {"type": "string"}, "skillVersion": {"type": "string"}, "specDigest": {"$ref": "#/$defs/digest"},
          "checkId": {"type": "string"}, "baseCheckId": {"type": "string"}, "required": {"type": "boolean"},
          "targetFingerprint": {"$ref": "#/$defs/digest"}, "actionFingerprint": {"$ref": "#/$defs/digest"}, "executionFingerprint": {"$ref": "#/$defs/digest"}, "failureFingerprint": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "deduplicated": {"type": "boolean"}, "deduplicatedFrom": {"type": "string"}, "deduplicatedFromCheckId": {"type": "string"},
          "adapter": {"enum": ["bash_syntax", "mana_eval", "java_approved_test"]},
          "adapterImplementationDigest": {"$ref": "#/$defs/digest"},
          "concernKey": {"type": "string", "pattern": "^concern:"},
          "rerunDescriptor": {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "repository_path"}, "path": {"type": "string"}}},
          "evaluationSurface": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "digest", "protected"], "properties": {"role": {"enum": ["mutable_input", "oracle", "configuration", "verifier"]}, "path": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}, "protected": {"type": "boolean"}}}},
          "trustOrigin": {"enum": ["framework_declared", "project_approved", "derived", "repository_script", "generated"]},
          "commandOrigin": {"type": "string"}, "effectiveArgv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "executable": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
          "workingDirectory": {"type": "string"}, "environmentClassification": {"const": "local"}, "environmentDigest": {"$ref": "#/$defs/digest"}, "inputDigest": {"$ref": "#/$defs/digest"},
          "scope": {"enum": ["changed_files", "relevant_scenarios", "changed_modules"]}, "costClass": {"enum": ["cheap", "normal", "expensive"]},
          "result": {"enum": ["passed", "failed", "blocked", "partial", "inconclusive"]}, "exitCode": {"type": ["integer", "null"]},
          "signal": {"type": "integer", "minimum": 0}, "timedOut": {"type": "boolean"}, "descendantsTerminated": {"type": "boolean"},
          "durationMs": {"type": "integer", "minimum": 0}, "timeoutSeconds": {"type": "integer", "minimum": 0}, "outputLimitBytes": {"type": "integer", "minimum": 0},
          "relevantFiles": {"type": "array", "items": {"type": "string"}},
          "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "result"], "properties": {"id": {"type": "string"}, "result": {"enum": ["satisfied", "not_satisfied"]}, "messages": {"type": "array", "items": {"type": "string"}}}}},
          "nativeArtifacts": {"type": "array", "items": {"type": "string"}},
          "output": {"type": "object", "additionalProperties": false, "required": ["excerpt", "stdoutArtifact", "stderrArtifact", "stdoutDigest", "stderrDigest", "stdoutBytes", "stderrBytes", "stdoutTruncated", "stderrTruncated"], "properties": {"excerpt": {"type": "string"}, "stdoutArtifact": {"type": "string"}, "stderrArtifact": {"type": "string"}, "stdoutDigest": {"$ref": "#/$defs/digest"}, "stderrDigest": {"$ref": "#/$defs/digest"}, "stdoutBytes": {"type": "integer", "minimum": 0}, "stderrBytes": {"type": "integer", "minimum": 0}, "stdoutTruncated": {"type": "boolean"}, "stderrTruncated": {"type": "boolean"}}},
          "declaredEffects": {"$ref": "#/$defs/effects"},
          "observedEffects": {"type": "object", "additionalProperties": false, "required": ["unexpectedSourceMutation", "mutationPaths"], "properties": {"unexpectedSourceMutation": {"type": "boolean"}, "mutationPaths": {"type": "array", "items": {"type": "string"}}}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"deduplicated": {"const": true}}}, "then": {"required": ["deduplicatedFrom", "deduplicatedFromCheckId"]}, "else": {"not": {"anyOf": [{"required": ["deduplicatedFrom"]}, {"required": ["deduplicatedFromCheckId"]}]}}}
        ]
      }
    },
    "observedEffects": {"type": "object", "additionalProperties": false, "required": ["unexpectedSourceMutation"], "properties": {"unexpectedSourceMutation": {"type": "boolean"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["wallTimeMs", "checksExecuted", "duplicateActionsSuppressed", "modelCalls", "inputTokens", "outputTokens"], "properties": {"wallTimeMs": {"type": "integer", "minimum": 0}, "checksExecuted": {"type": "integer", "minimum": 0}, "duplicateActionsSuppressed": {"type": "integer", "minimum": 0}, "modelCalls": {"const": 0}, "inputTokens": {"const": 0}, "outputTokens": {"const": 0}}},
    "judgment": {"type": "null"}
  },
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": "2"}}}, "then": {"required": ["frameworkIdentity", "rerunOf"], "properties": {"checks": {"items": {"required": ["adapterImplementationDigest", "concernKey", "rerunDescriptor", "evaluationSurface"]}}}}}]
}
