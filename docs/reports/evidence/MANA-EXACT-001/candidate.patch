+            },
+            "budget": {
+                "attempts": 1,
+                "verification_commands": 4,
+                "timeout_seconds": 1,
+                "total_seconds": 12,
+                "output_bytes": 16384,
+                "file_bytes": 1048576,
+            },
+            "runtime": {"test": "component double only"},
+            "authorization_reference": "test-grant",
+            "protected_files": [str(self.protected)],
+            "provider": "none",
+            "operation": "repair-verify",
+            "baseline": {"test_exit": 0, "stdout_sha256": x.digest(b"")},
