+        ]
+        appedges.append(
+            {
+                "from": node_id(a),
+                "to": node_id(b),
+                "claim": c["id"],
+                "certainty": "CONDITIONAL",
+            }
+        )
+    if len(dbedges) + len(appedges) + len(cross) > BUDGETS["serializedEdges"]:
