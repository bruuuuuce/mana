+                    w["namespace"]["participantId"]
+                    == h["namespace"]["participantId"]
+                    == pid
+                    and app["callerPhysical"] == h["namespace"]["originalPhysicalId"]
+                    and app["calleePhysical"] == w["namespace"]["originalPhysicalId"]
+                    and app["enterT01Sequence"]
+                    < cut["prefixes"][pid]
+                    <= app["exitT01Sequence"]
+                ):
