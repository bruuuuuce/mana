+    def case(self, name="O-A01"):
+        return scenarios.materialize(name, self.models)
+
+    def report(self, name="O-A01"):
+        raw, sidecar = self.case(name)
+        result = wd.build_report(raw, sidecar)
+        validate_report(result, raw)
+        return result
