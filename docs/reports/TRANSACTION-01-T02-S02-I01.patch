+                            {
+                                "candidate": candidate["id"],
+                                "cut": cut["id"],
+                                "reason": candidate["status"],
+                                "missingObligations": [
+                                    w["id"] for w in ledger if w["state"] == "UNKNOWN"
+                                ],
+                                "contradictedObligations": [
+                                    w["id"]
+                                    for w in ledger
+                                    if w["state"] == "CONTRADICTED"
+                                ],
+                            }
+                        )
+    for app in app_sources:
+        a = namespace(s, app["participant"], app["caller"], "F")
