+            args += ["--timeline", key + "=" + str(path)]
+        scenario = base / "scenario.json"
+        scenario.write_text(json.dumps(sidecar))
+        args += ["--scenario", str(scenario)]
+        output = base / "output"
+        run = subprocess.run(
