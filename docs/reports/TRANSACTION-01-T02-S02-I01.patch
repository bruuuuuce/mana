+            "APPLICATION_WAIT_DEPENDENCY",
+            [],
+            "CONDITIONAL",
+            caller=a,
+            callee=b,
+            callerPhysical=namespace(s, app["participant"], app["callerPhysical"]),
+            calleePhysical=namespace(s, app["participant"], app["calleePhysical"]),
