{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/mana-inspect/v1/activity-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "events",
    "coverage",
    "diagnostics",
    "guarantees",
    "view_revision",
    "next_cursor",
    "total_events"
  ],
  "properties": {
    "schema": {
      "const": "mana.inspect.activity-page/v1"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "event_kind",
          "work_item_id",
          "related_artifact_ids",
          "provenance"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "provenance"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "enum": [
                  "explicit_domain_timestamp",
                  "filesystem_mtime_epoch"
                ]
              }
            }
          },
          "event_kind": {
            "enum": [
              "workspace_created",
              "verification_completed",
              "review_recorded",
              "decision_recorded",
              "artifact_updated",
              "unknown"
            ]
          },
          "work_item_id": {
            "anyOf": [
              {
                "$ref": "work-items.schema.json#/$defs/workItemId"
              },
              {
                "type": "null"
              }
            ]
          },
          "related_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {
            "$ref": "#/$defs/artifactTarget"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "$ref": "work-items.schema.json#/$defs/provenance"
          }
        }
      },
      "maxItems": 500
    },
    "coverage": {
      "enum": [
        "explicit_structured_events",
        "explicit_and_filesystem_fallback",
        "none",
        "unknown"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "work-items.schema.json#/$defs/diagnostic"
      }
    },
    "guarantees": {
      "$ref": "work-items.schema.json#/$defs/guarantees"
    },
    "view_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}:[1-9][0-9]{0,9}$"
    },
    "total_events": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "artifactTarget": {
      "description": "Optional typed navigation reference for an artifact-backed event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "work_item_id",
        "section_id",
        "project_context_category",
        "label"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "work_item_id": {
          "anyOf": [
            {
              "$ref": "work-items.schema.json#/$defs/workItemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "section_id": {
          "enum": [
            "overview",
            "requirements",
            "plan",
            "decisions",
            "evidence",
            "review",
            "timeline",
            "artifacts",
            null
          ]
        },
        "project_context_category": {
          "enum": [
            "architecture",
            "project_decisions",
            "integrations",
            "engineering_guards",
            "glossary",
            "learning_journeys",
            "testing_policy",
            "database_policy",
            null
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
