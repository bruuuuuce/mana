{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mana.model-tier-eligibility/v1",
  "title": "MANA semantic model-tier eligibility policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "selectionPolicy", "rationale", "rules"],
  "properties": {
    "schemaVersion": {"const": "mana.model-tier-eligibility/v1"},
    "policyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "selectionPolicy": {"const": "highest-discovered-version-within-first-eligible-family"},
    "rationale": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "defaultEffort", "efforts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
          "provider": {"enum": ["codex", "claude", "opencode"]},
          "modelAlias": {"type": "string", "minLength": 1},
          "modelPattern": {"type": "string", "minLength": 1},
          "defaultEffort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
          "efforts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "medium", "high", "xhigh", "max"]}}
        },
        "oneOf": [
          {"required": ["modelAlias"], "not": {"required": ["modelPattern"]}},
          {"required": ["modelPattern"], "not": {"required": ["modelAlias"]}}
        ]
      }
    }
  }
}
