{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/story-start/scope-v2/schemas/provenance.schema.json",
  "title": "Mana Story Start provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactVersion",
    "artifactId",
    "storyId",
    "records",
    "evidenceRefs",
    "validationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mana.story-start.provenance/v2"
    },
    "artifactVersion": {
      "const": 2
    },
    "artifactId": {
      "type": "string",
      "pattern": "^provenance_[0-9a-f]{64}$"
    },
    "storyId": {
      "$ref": "common.schema.json#/$defs/storyId"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/provenanceRecord"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceId"
      }
    },
    "validationStatus": {
      "$ref": "common.schema.json#/$defs/validationStatus"
    }
  }
}
