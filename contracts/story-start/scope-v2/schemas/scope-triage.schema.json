{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/story-start/scope-v2/schemas/scope-triage.schema.json",
  "title": "Mana Story Start scope triage v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactVersion",
    "artifactId",
    "storyId",
    "sourceDiscoveryArtifactRef",
    "classifications",
    "decisions",
    "scopeExpansions",
    "validationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mana.story-start.scope-triage/v2"
    },
    "artifactVersion": {
      "const": 2
    },
    "artifactId": {
      "type": "string",
      "pattern": "^triage_[0-9a-f]{64}$"
    },
    "storyId": {
      "$ref": "common.schema.json#/$defs/storyId"
    },
    "sourceDiscoveryArtifactRef": {
      "type": "string",
      "pattern": "^discovery_[0-9a-f]{64}$"
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/scopeClassification"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      }
    },
    "scopeExpansions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/scopeExpansion"
      }
    },
    "validationStatus": {
      "$ref": "common.schema.json#/$defs/validationStatus"
    }
  }
}
