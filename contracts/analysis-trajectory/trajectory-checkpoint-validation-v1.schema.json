{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mana.analysis-trajectory.trajectory-checkpoint-validation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "responseHash", "status", "repairPermitted", "errors"],
  "properties": {
    "schemaVersion": {"const": "mana.analysis-trajectory.trajectory-checkpoint-validation/v1"},
    "requestId": {"$ref": "common-v1.schema.json#/$defs/ref"},
    "responseHash": {"anyOf": [{"$ref": "common-v1.schema.json#/$defs/hash"}, {"type": "null"}]},
    "status": {"enum": ["VALID", "STRUCTURAL_INVALID", "SEMANTIC_INVALID", "PROVIDER_FAILED"]},
    "repairPermitted": {"type": "boolean"},
    "errors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path"],
        "properties": {
          "code": {"$ref": "common-v1.schema.json#/$defs/ref"},
          "path": {"$ref": "common-v1.schema.json#/$defs/ref"}
        }
      }
    }
  }
}
