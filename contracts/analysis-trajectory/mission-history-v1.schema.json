{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mana.analysis-trajectory.mission-history/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "revisionCount", "revisions"],
  "properties": {
    "schemaVersion": {"const": "mana.analysis-trajectory.mission-history/v1"},
    "missionId": {"type": "string", "pattern": "^mission-[0-9a-f]{24}$"},
    "revisionCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "revisions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "mission-contract-v1.schema.json"}}
  }
}
