{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mana.local/contracts/mana-review-scheduler/v1/inbox.schema.json","type":"object","additionalProperties":false,"required":["schema","items"],"properties":{"schema":{"const":"mana.review-scheduler.inbox/v1"},"items":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/run"}}},
  "$defs":{"run":{"type":"object","additionalProperties":false,"required":["run_id","repository","pr_number","head_sha","reviewer","profile_revision","context_revision","title","url","updated_at","status","attempt","draft_revision","error_code","publication_status","created_at","changed_at","stale"],"properties":{"run_id":{"type":"string","pattern":"^review_[0-9a-f]{24}$"},"repository":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},"pr_number":{"type":"integer","minimum":1},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"reviewer":{"type":"string"},"profile_revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"context_revision":{"type":"string"},"title":{"type":"string","maxLength":256},"url":{"type":"string","maxLength":1024},"updated_at":{"type":"string"},"status":{"enum":["notified","queued","running","completed","failed","interrupted","cancelled"]},"attempt":{"type":"integer","minimum":0},"draft_revision":{"type":["string","null"]},"error_code":{"type":["string","null"]},"publication_status":{"type":["string","null"]},"created_at":{"type":"string"},"changed_at":{"type":"string"},"stale":{"type":"boolean"}}}}
