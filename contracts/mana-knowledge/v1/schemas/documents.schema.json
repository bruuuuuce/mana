{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/mana-knowledge/v1/documents.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "index", "filters", "documents", "next_offset", "diagnostics"],
  "properties": {
    "schema": {"const": "mana.knowledge.documents/v1"},
    "index": {"type": "object", "required": ["freshness", "reason", "revision"]},
    "filters": {"type": "object", "required": ["scopes", "lifecycles"]},
    "documents": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/document"}},
    "next_offset": {"type": ["integer", "null"], "minimum": 0},
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_reference", "source_scope", "lifecycle_state", "title", "document_revision", "byte_size"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"},
        "source_reference": {"type": "string", "minLength": 1},
        "source_scope": {"enum": ["framework", "user", "project", "candidate"]},
        "lifecycle_state": {"enum": ["active", "candidate", "reviewed", "rejected", "deferred", "archived", "superseded"]},
        "title": {"type": ["string", "null"]},
        "document_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    }
  }
}
