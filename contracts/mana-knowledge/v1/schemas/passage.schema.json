{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mana.local/contracts/mana-knowledge/v1/passage.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","index","passage","diagnostics"],
  "properties":{
    "schema":{"const":"mana.knowledge.passage/v1"},
    "index":{"type":"object","required":["freshness","reason","revision"]},
    "passage":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["passage_id","document_id","title","heading_path","body","truncated","source_reference","source_scope","lifecycle_state","document_revision","passage_revision"],"properties":{
      "passage_id":{"type":"string","pattern":"^psg_[0-9a-f]{24}$"},"document_id":{"type":"string","pattern":"^doc_[0-9a-f]{24}$"},"title":{"type":"string"},"heading_path":{"type":"array","items":{"type":"string"}},"body":{"type":"string"},"truncated":{"type":"boolean"},"source_reference":{"type":"string"},"source_scope":{"enum":["framework","user","project","candidate"]},"lifecycle_state":{"enum":["active","candidate","reviewed","rejected","archived","superseded"]},"document_revision":{"type":"string"},"passage_revision":{"type":"string"}
    }}]},
    "diagnostics":{"type":"array","items":{"type":"object"}}
  }
}
