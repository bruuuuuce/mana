{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/host-authority-context-v1.schema.json",
  "title": "Mana host-owned authority context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionIdentity", "effectivePermissions", "humanGates", "approvalRecords"],
  "properties": {
    "schemaVersion": {"const": "mana.context-runtime.host-authority-context/v1"},
    "executionIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["executionId", "executionVersion", "profileId", "issuedAt", "issuer"],
      "properties": {
        "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
        "executionVersion": {"type": "integer", "minimum": 1},
        "profileId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
        "issuedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$", "minLength": 20, "maxLength": 40},
        "issuer": {"type": "string", "pattern": "^host:[A-Za-z0-9._-]{1,120}$"}
      }
    },
    "effectivePermissions": {"$ref": "execution-envelope-v1.schema.json#/$defs/permissions"},
    "humanGates": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gateId", "description"],
        "properties": {
          "gateId": {"type": "string", "pattern": "^GATE-[A-Za-z0-9._-]{1,120}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "approvalRecords": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "#/$defs/approvalRecord"}
    }
  },
  "$defs": {
    "approvalRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["approvalId", "recordVersion", "executionId", "executionVersion", "gateId", "decision", "completedAt", "provenance"],
      "properties": {
        "approvalId": {"type": "string", "pattern": "^APR-[A-Za-z0-9._-]{1,120}$"},
        "recordVersion": {"const": 1},
        "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
        "executionVersion": {"type": "integer", "minimum": 1},
        "gateId": {"type": "string", "pattern": "^GATE-[A-Za-z0-9._-]{1,120}$"},
        "decision": {"const": "approved"},
        "completedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$", "minLength": 20, "maxLength": 40},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "actorId", "recordedBy", "sourceRecordId"],
          "properties": {
            "source": {"const": "human"},
            "actorId": {"type": "string", "minLength": 1, "maxLength": 120},
            "recordedBy": {"type": "string", "pattern": "^host:[A-Za-z0-9._-]{1,120}$"},
            "sourceRecordId": {"type": "string", "pattern": "^HOST-APR-[A-Za-z0-9._-]{1,120}$"}
          }
        }
      }
    }
  }
}
