{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/model-fact-v1.schema.json",
  "title": "Mana model-owned typed fact components v1",
  "$defs": {
    "evidence": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]{1,120}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "kind", "identifier"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["repository", "evidence", "requirement", "test", "runtime-observation", "external-observation", "application"]
        },
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]-[A-Za-z0-9._-]{1,120}$"},
        "subject": {"$ref": "#/$defs/subject"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "claim", "evidenceRefs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]-[A-Za-z0-9._-]{1,120}$"},
        "subject": {"$ref": "#/$defs/subject"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "facts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "question", "requiredEvidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q-[A-Za-z0-9._-]{1,120}$"},
        "subject": {"$ref": "#/$defs/subject"},
        "question": {"type": "string", "minLength": 1, "maxLength": 512},
        "requiredEvidence": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  }
}
