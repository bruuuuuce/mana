{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/finding-validation-v1.schema.json",
  "title": "Mana Context Runtime finding validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findingId", "executionId", "subject", "status", "claim", "evidenceRefs", "openQuestions"],
  "properties": {
    "schemaVersion": {"const": "mana.context-runtime.finding-validation/v1"},
    "findingId": {"type": "string", "pattern": "^F-[A-Za-z0-9._-]{1,120}$"},
    "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
    "subject": {"$ref": "model-fact-v1.schema.json#/$defs/subject"},
    "status": {"type": "string", "enum": ["validated", "rejected", "needs-evidence"]},
    "claim": {"type": "string", "minLength": 1, "maxLength": 512},
    "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "model-fact-v1.schema.json#/$defs/evidence"}},
    "openQuestions": {"type": "array", "maxItems": 32, "items": {"$ref": "model-fact-v1.schema.json#/$defs/question"}}
  }
}
