{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/worker-context-packet-v1.schema.json",
  "title": "Mana Context Runtime host-owned worker context packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "governanceEnvelope", "delegationTask", "contextManifestProjection", "activeSkills", "evidenceRefs", "outputContract", "modelSelection"],
  "properties": {
    "schemaVersion": {"const": "mana.context-runtime.worker-context-packet/v1"},
    "governanceEnvelope": {"oneOf": [{"$ref": "execution-envelope-v1.schema.json"}, {"$ref": "execution-envelope-v2.schema.json"}]},
    "delegationTask": {"$ref": "delegation-task-v1.schema.json"},
    "contextManifestProjection": {"$ref": "#/$defs/manifestProjection"},
    "activeSkills": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/activeSkill"}
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E-[a-f0-9]{64}$"}
    },
    "outputContract": {"$ref": "delegation-task-v1.schema.json#/properties/expectedOutput"},
    "modelSelection": {"$ref": "#/$defs/modelSelection"}
  },
  "$defs": {
    "skillMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "activationSignal", "modelTier", "riskLevel", "executionMode", "delegationGroup", "parallelSafe"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
        "reason": {"type": "string", "enum": ["baseline", "static-signal", "semantic-request", "legacy-fallback"]},
        "activationSignal": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "modelTier": {"type": "string", "enum": ["economy", "full", "unspecified"]},
        "riskLevel": {"type": "string", "enum": ["low", "medium", "high", "unspecified"]},
        "executionMode": {"const": "read"},
        "delegationGroup": {"type": "string", "enum": ["requirements", "source", "tests", "architecture", "contracts", "database", "security", "operations", "unspecified"]},
        "parallelSafe": {"const": true}
      }
    },
    "manifestProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourceManifestSchemaVersion", "sourceManifestDigest", "executionId", "profileId", "taskSkills", "limits"],
      "properties": {
        "schemaVersion": {"const": "mana.context-runtime.worker-manifest-projection/v1"},
        "sourceManifestSchemaVersion": {"const": "mana.context-runtime.context-manifest/v1"},
        "sourceManifestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
        "profileId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
        "taskSkills": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/skillMetadata"}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerDepth", "retrievalCyclesPerQuestion"],
          "properties": {
            "workerDepth": {"const": 0},
            "retrievalCyclesPerQuestion": {"type": "integer", "minimum": 1, "maximum": 16}
          }
        }
      }
    },
    "activeSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "body", "bodyDigest"],
      "properties": {
        "metadata": {"$ref": "#/$defs/skillMetadata"},
        "body": {"type": "string", "minLength": 1, "maxLength": 65536},
        "bodyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "modelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelTier", "modelId", "reasoningEffort", "policyId", "policyDigest", "routingReasons"],
      "properties": {
        "provider": {"type": "string", "enum": ["codex", "claude", "opencode"]},
        "modelTier": {"type": "string", "enum": ["economy", "full"]},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n]+$"},
        "reasoningEffort": {"type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max"]},
        "policyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
        "policyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "routingReasons": {"type": "array", "minItems": 1, "maxItems": 17, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9:_-]{1,160}$"}}
      }
    }
  }
}
