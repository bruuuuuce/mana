{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mana.context-runtime.semantic-comparison/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "registration",
    "sources",
    "authority",
    "permissionGrant",
    "externalActions",
    "executedRuntimes",
    "equivalenceScope",
    "provenanceScope",
    "humanReviewRequired",
    "nonDegradation",
    "status",
    "complete",
    "byteIdentical",
    "representationOnly",
    "reasons",
    "dimensions",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mana.context-runtime.semantic-comparison/v1"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "registration": {
      "$ref": "#/$defs/artifactIdentity"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "v2"
      ],
      "properties": {
        "legacy": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "v2": {
          "$ref": "#/$defs/sourceIdentity"
        }
      }
    },
    "authority": {
      "const": "none"
    },
    "permissionGrant": {
      "const": "none"
    },
    "externalActions": {
      "const": "disabled"
    },
    "executedRuntimes": {
      "const": []
    },
    "equivalenceScope": {
      "const": "declared-structured-semantics-v1"
    },
    "provenanceScope": {
      "const": "registered-artifact-bytes-and-declared-evidence-metadata"
    },
    "humanReviewRequired": {
      "type": "boolean",
      "const": true
    },
    "nonDegradation": {
      "const": "not-established"
    },
    "status": {
      "$ref": "#/$defs/outcome"
    },
    "complete": {
      "type": "boolean"
    },
    "byteIdentical": {
      "type": "boolean"
    },
    "representationOnly": {
      "type": "boolean"
    },
    "reasons": {
      "$ref": "#/$defs/reasons"
    },
    "dimensions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "semanticKey",
          "stances",
          "declaredThroughUncertainty",
          "reason",
          "observations"
        ],
        "properties": {
          "side": {
            "enum": [
              "legacy",
              "v2"
            ]
          },
          "semanticKey": {
            "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
          },
          "stances": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "enum": [
                "affirmed",
                "denied",
                "uncertain"
              ]
            }
          },
          "declaredThroughUncertainty": {
            "type": "boolean"
          },
          "reason": {
            "const": "unresolved_internal_conflict"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
        }
      }
    },
    "outcome": {
      "enum": [
        "equivalent",
        "different",
        "indeterminate"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported-format",
          "unsupported-contract",
          "target-mismatch",
          "profile-mismatch",
          "dimension-missing",
          "coverage-incomplete",
          "declared-gap",
          "unknown-value",
          "open-question",
          "artifact-incomplete",
          "evidence-incomplete",
          "provenance-unavailable",
          "uncertain-observation",
          "required-escalation-unavailable",
          "required-escalation-unspecified",
          "high-risk-evidence-unavailable",
          "observed-value-difference",
          "one-sided-observation",
          "provenance-difference",
          "missing-evidence",
          "contradictory-evidence",
          "scope-incomplete",
          "unverified",
          "model-escalation-unavailable",
          "source-stale",
          "unresolved_internal_conflict"
        ]
      }
    },
    "value": {
      "anyOf": [
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/status"
        },
        {
          "enum": [
            "covered",
            "uncovered",
            "useful",
            "not-useful",
            "undecided"
          ]
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/finding"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/evidence"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/approval"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/risk"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/escalation"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/question"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/artifact"
        },
        {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/writePolicy"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "pointer",
        "metadata",
        "uncertainty"
      ],
      "properties": {
        "recordId": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/id"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "metadata": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/evidence"
        },
        "uncertainty": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/uncertainty"
        }
      }
    },
    "pointer": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^/dimensions/[A-Za-z]+/records/[0-9]+$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "pointer",
        "value",
        "evidenceRefs",
        "evidence",
        "uncertainty"
      ],
      "properties": {
        "recordId": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/id"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "evidenceRefs": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/ids"
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "uncertainty": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/uncertainty"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticKey",
        "status",
        "reasons",
        "legacy",
        "v2"
      ],
      "properties": {
        "semanticKey": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
        },
        "status": {
          "$ref": "#/$defs/outcome"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        },
        "legacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "v2": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "complete",
        "coverage",
        "gaps",
        "reasons",
        "records"
      ],
      "properties": {
        "name": {
          "enum": [
            "status",
            "blockers",
            "warnings",
            "evidenceReferences",
            "requirementCoverage",
            "approvalGates",
            "activatedRiskDomains",
            "highRiskEscalation",
            "unresolvedQuestions",
            "artifactCompleteness",
            "humanUsefulnessDisposition",
            "externalWritePolicy"
          ]
        },
        "status": {
          "$ref": "#/$defs/outcome"
        },
        "complete": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy",
            "v2"
          ],
          "properties": {
            "legacy": {
              "enum": [
                "complete",
                "partial",
                "unavailable",
                "not-applicable",
                "missing"
              ]
            },
            "v2": {
              "enum": [
                "complete",
                "partial",
                "unavailable",
                "not-applicable",
                "missing"
              ]
            }
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy",
            "v2"
          ],
          "properties": {
            "legacy": {
              "$ref": "semantic-comparison-input-v1.schema.json#/$defs/uncertainty"
            },
            "v2": {
              "$ref": "semantic-comparison-input-v1.schema.json#/$defs/uncertainty"
            }
          }
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        },
        "records": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    "fileInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "size",
        "mtime_ns",
        "ctime_ns"
      ],
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mtime_ns": {
          "type": "integer",
          "minimum": 0
        },
        "ctime_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "fileInstance",
        "producerRuntime",
        "producerReceiptDigest",
        "profileId",
        "targetKey",
        "executionVersion"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
        },
        "fileInstance": {
          "$ref": "#/$defs/fileInstance"
        },
        "producerRuntime": {
          "enum": [
            "legacy",
            "v2"
          ]
        },
        "producerReceiptDigest": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
        },
        "profileId": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/id"
        },
        "targetKey": {
          "$ref": "semantic-comparison-input-v1.schema.json#/$defs/digest"
        },
        "executionVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
