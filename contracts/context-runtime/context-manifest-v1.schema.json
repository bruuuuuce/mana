{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/context-manifest-v1.schema.json",
  "title": "Mana Context Runtime context manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "executionId", "profileId", "activationMode",
    "semanticAgents", "declaredCandidateSkills", "baselineSkills",
    "staticallyActivatedSkills", "semanticallyRequestedSkills",
    "activatedSkills", "deepLoadedSkills", "inactiveSkills",
    "availableConditionalSkills", "modelEscalationSkills",
    "writePermissionRequirements", "requiredArtifacts", "limits", "warnings"
  ],
  "properties": {
    "schemaVersion": {"const": "mana.context-runtime.context-manifest/v1"},
    "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
    "profileId": {"$ref": "#/$defs/id"},
    "activationMode": {"type": "string", "enum": ["declarative", "legacy-fallback"]},
    "semanticAgents": {"$ref": "#/$defs/ids"},
    "declaredCandidateSkills": {"$ref": "#/$defs/ids"},
    "baselineSkills": {"$ref": "#/$defs/ids"},
    "staticallyActivatedSkills": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/signalActivation"}},
    "semanticallyRequestedSkills": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill", "signal"],
        "properties": {"skill": {"$ref": "#/$defs/id"}, "signal": {"$ref": "#/$defs/signal"}}
      }
    },
    "activatedSkills": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reason", "activationSignal", "modelTier", "riskLevel", "executionMode", "delegationGroup", "parallelSafe"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "reason": {"type": "string", "enum": ["baseline", "static-signal", "semantic-request", "legacy-fallback"]},
          "activationSignal": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$"},
          "modelTier": {"type": "string", "enum": ["economy", "full", "unspecified"]},
          "riskLevel": {"type": "string", "enum": ["low", "medium", "high", "unspecified"]},
          "executionMode": {"type": "string", "enum": ["read", "write", "unspecified"]},
          "delegationGroup": {"type": "string", "enum": ["requirements", "source", "tests", "architecture", "contracts", "database", "security", "operations", "documentation", "implementation", "unspecified"]},
          "parallelSafe": {"type": ["boolean", "null"]}
        }
      }
    },
    "deepLoadedSkills": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "instructionPath"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "instructionPath": {"$ref": "#/$defs/path"}}
      }
    },
    "inactiveSkills": {"$ref": "#/$defs/ids"},
    "availableConditionalSkills": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/signalActivation"}},
    "modelEscalationSkills": {"$ref": "#/$defs/ids"},
    "writePermissionRequirements": {"$ref": "#/$defs/ids"},
    "requiredArtifacts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["directWorkers", "workerDepth", "retrievalCyclesPerQuestion"],
      "properties": {
        "directWorkers": {"type": "integer", "minimum": 0, "maximum": 32},
        "workerDepth": {"const": 0},
        "retrievalCyclesPerQuestion": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "warnings": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
    "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "signal": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "signalActivation": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "skill"],
      "properties": {"signal": {"$ref": "#/$defs/signal"}, "skill": {"$ref": "#/$defs/id"}}
    },
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$"}
  }
}
