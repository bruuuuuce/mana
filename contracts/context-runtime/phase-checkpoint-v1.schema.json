{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/phase-checkpoint-v1.schema.json",
  "title": "Mana untrusted model-owned phase checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "checkpointId", "executionId", "executionVersion", "profileId", "phaseId", "status",
    "verifiedFacts", "assumptions", "inferences", "openQuestions",
    "closedHypotheses", "candidateFindings", "approvalRequests",
    "activatedSkills", "evidenceRefs", "nextActionRequest"
  ],
  "properties": {
    "comparisonMergeRef": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^phases/[0-9]{3}-[A-Za-z0-9_-]+/delegation-merge-v1.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "comparisonProjection": {
      "$ref": "semantic-comparison-input-v1.schema.json"
    },
    "schemaVersion": {"const": "mana.context-runtime.phase-checkpoint/v1"},
    "checkpointId": {"type": "string", "pattern": "^C-[A-Za-z0-9._-]{1,120}$"},
    "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
    "executionVersion": {"type": "integer", "minimum": 1},
    "profileId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
    "phaseId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
    "verifiedFacts": {"$ref": "model-fact-v1.schema.json#/$defs/facts"},
    "assumptions": {"type": "array", "maxItems": 32, "items": {"$ref": "model-fact-v1.schema.json#/$defs/claim"}},
    "inferences": {"$ref": "model-fact-v1.schema.json#/$defs/facts"},
    "openQuestions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/question"}},
    "closedHypotheses": {"$ref": "model-fact-v1.schema.json#/$defs/facts"},
    "candidateFindings": {"type": "array", "maxItems": 32, "items": {"$ref": "model-fact-v1.schema.json#/$defs/fact"}},
    "approvalRequests": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/approvalRequest"}},
    "activatedSkills": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"}},
    "evidenceRefs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "nextActionRequest": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["kind", "targetId", "reason"],
      "properties": {
        "kind": {"type": "string", "enum": ["next-declared-phase", "repeat-current-phase", "stop"]},
        "targetId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  },
  "$defs": {
    "evidence": {"$ref": "model-fact-v1.schema.json#/$defs/evidence"},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "question", "requiredEvidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q-[A-Za-z0-9._-]{1,120}$"},
        "subject": {"$ref": "model-fact-v1.schema.json#/$defs/subject"},
        "question": {"type": "string", "minLength": 1, "maxLength": 512},
        "requiredEvidence": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "approvalRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["approvalId", "gateId"],
      "properties": {
        "approvalId": {"type": "string", "pattern": "^APR-[A-Za-z0-9._-]{1,120}$"},
        "gateId": {"type": "string", "pattern": "^GATE-[A-Za-z0-9._-]{1,120}$"}
      }
    }
  }
}
