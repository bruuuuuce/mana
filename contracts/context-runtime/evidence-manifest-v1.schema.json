{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mana.local/contracts/context-runtime/evidence-manifest-v1.schema.json",
  "title": "Mana Context Runtime evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionId", "workspaceId", "items"],
  "properties": {
    "schemaVersion": {"const": "mana.context-runtime.evidence-manifest/v1"},
    "executionId": {"type": "string", "pattern": "^execution-[A-Za-z0-9._-]{1,120}$"},
    "workspaceId": {"type": "string", "pattern": "^W-[a-f0-9]{64}$"},
    "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^E-[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payloadRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localPath", "digest", "byteSize"],
      "properties": {
        "localPath": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"},
        "byteSize": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    },
    "collectionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "sourceSystem", "sourceLocator", "collectedAt", "mediaType", "sensitivity", "normalizationVersion", "relationships", "collectionStatus", "revisionId"],
      "properties": {
        "evidenceId": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "sourceSystem": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "sourceLocator": {"type": "string", "minLength": 1, "maxLength": 2048},
        "collectedAt": {"type": "string", "minLength": 20, "maxLength": 40},
        "digest": {"$ref": "#/$defs/digest"},
        "mediaType": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"},
        "byteSize": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sensitivity": {"type": "string", "enum": ["public", "internal", "restricted", "secret"]},
        "localPath": {"$ref": "#/$defs/path"},
        "normalizationVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "relationships": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "collectionStatus": {"type": "string", "enum": ["complete", "partial", "unavailable", "failed"]},
        "revisionId": {"type": ["string", "null"], "maxLength": 256},
        "sourcePayload": {"$ref": "#/$defs/payloadRepresentation"},
        "normalizedRepresentation": {"$ref": "#/$defs/payloadRepresentation"},
        "collectionError": {"$ref": "#/$defs/collectionError"},
        "gaps": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      },
      "oneOf": [
        {
          "required": ["digest", "byteSize", "localPath", "sourcePayload", "normalizedRepresentation"],
          "properties": {"collectionStatus": {"const": "complete"}, "collectionError": false, "gaps": false}
        },
        {
          "required": ["digest", "byteSize", "localPath", "sourcePayload", "normalizedRepresentation", "collectionError", "gaps"],
          "properties": {"collectionStatus": {"const": "partial"}}
        },
        {
          "required": ["collectionError"],
          "properties": {"collectionStatus": {"const": "failed"}, "digest": false, "byteSize": false, "localPath": false, "sourcePayload": false, "normalizedRepresentation": false, "gaps": false}
        },
        {
          "required": ["collectionError"],
          "properties": {"collectionStatus": {"const": "unavailable"}, "digest": false, "byteSize": false, "localPath": false, "sourcePayload": false, "normalizedRepresentation": false, "gaps": false}
        }
      ]
    }
  }
}
